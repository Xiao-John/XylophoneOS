# Preserve verbatim upstream license text including its original final blank line.
src/ports/qt6/licenses/ZLIB-LICENSE whitespace=-blank-at-eof
src/ports/qt6/licenses/Zlib.txt whitespace=-blank-at-eof
# Unified patch context lines require a leading space, including blank context.
src/ports/qt6/patches/*.patch whitespace=-blank-at-eol
# Freeze compatibility CSV bytes exactly; csv.writer emits CRLF and receipts hash it.
docs/reports/modern_apps_20261029/*_matrix.csv -text whitespace=cr-at-eol
# Preserve the dependency's original license whitespace verbatim.
licenses/modern_apps/defusedxml_LICENSE -whitespace

# The pinned liteHTML unified diff preserves upstream tab/blank context bytes.
src/ports/aurora_browser/patches/*.patch whitespace=-blank-at-eol,-space-before-tab

# Diagnostic unified diffs retain the required leading space on blank context.
docs/reports/ssg_p3c_engine_neutral_20261031/*.patch whitespace=-blank-at-eol,-space-before-tab
