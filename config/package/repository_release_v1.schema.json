{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XOS authenticated repository release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "repository_id",
    "target_profile",
    "key_epoch",
    "sequence",
    "issued_at",
    "expires_at",
    "generation_id",
    "index_sha256",
    "lock_sha256",
    "generation_sha256"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "target_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "generation_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
