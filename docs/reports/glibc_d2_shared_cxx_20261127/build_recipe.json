    "configure-libgcc": [
      "${XOS_CXX_BUILD}/work/gcc-16.2.0/libgcc/configure",
      "--build=aarch64-unknown-linux-gnu",
      "--host=x86_64-unknown-xos",
      "--enable-shared",
      "--disable-gcov"
    ],
    "gcc-target-headers": [
      "sh",
      "${XOS_CXX_BUILD}/work/gcc-16.2.0/gcc/mkconfig.sh",
      "tconfig.h"
    ],
    "build-libgcc": [
      "/usr/bin/make",
      "-j1",
      "gcc_objdir=${XOS_CXX_BUILD}/work/gcc",
      "SHLIB_LC=-lc",
      "LIBGCC2_DEBUG_CFLAGS=-g0",
      "libgcc_s.so"
    ],
    "build-libm": [
      "/usr/bin/make",
      "-C",
      "${XOS_GLIBC_SOURCE}/math",
      "objdir=${XOS_GNU_BUILD_COPY}",
      "-j1",
      "-o",
      "${XOS_GNU_BUILD_COPY}/libc.so",
      "-o",
      "${XOS_GNU_BUILD_COPY}/elf/ld.so",
      "link-libc-deps=${XOS_GNU_BUILD_COPY}/libc.so ${XOS_GNU_BUILD_COPY}/elf/ld.so ${XOS_CXX_BUILD}/work/target/libgcc/libgcc_s.so.1",
      "link-libc-args=${XOS_GNU_BUILD_COPY}/libc.so -Wl,--as-needed ${XOS_CXX_BUILD}/work/target/libgcc/libgcc_s.so.1 ${XOS_GNU_BUILD_COPY}/elf/ld.so",
      "LDFLAGS-m.so=-nostdlib -Wl,-shared,--eh-frame-hdr,-z,now,-z,relro,-z,noexecstack,-z,nomark-plt,-z,nopack-relative-relocs,-z,max-page-size=8192,-z,separate-code",
      "${XOS_GNU_BUILD_COPY}/math/libm.so"
    ],
    "configure-libstdcxx": [
      "${XOS_CXX_BUILD}/work/gcc-16.2.0/libstdc++-v3/configure",
      "--build=aarch64-unknown-linux-gnu",
      "--host=x86_64-unknown-xos",
      "--prefix=/usr",
      "--with-gxx-include-dir=/usr/include/c++/16.2.0",
      "--disable-multilib",
      "--enable-shared",
      "--disable-static",
      "--disable-nls",
      "--disable-libstdcxx-pch",
      "--enable-libstdcxx-threads=yes",
      "--enable-clocale=generic",
      "--disable-libstdcxx-backtrace",
      "--disable-libstdcxx-filesystem-ts"
    ],
    "build-libstdcxx": [
      "/usr/bin/make",
      "-j1"
    ],
    "install-headers-include": [
      "/usr/bin/make",
      "-C",
      "${XOS_CXX_BUILD}/work/std/include",
      "install",
      "DESTDIR=${XOS_CXX_BUILD}/work/install"
    ],
    "install-headers-libsupcxx": [
      "/usr/bin/make",
      "-C",
      "${XOS_CXX_BUILD}/work/std/libsupc++",
      "install-data",
      "DESTDIR=${XOS_CXX_BUILD}/work/install"
    ]
  },
