+
+bool element::get_rendering_fragments(position::vector& boxes, unsigned limit) const
+{
+    boxes.clear();
+    for(const auto& weak : m_renders)
+    {
+        auto render = weak.lock();
+        if(!render || !render->is_visible()) continue;
+        position::vector fragments;
+        render->get_rendering_boxes(fragments);
+        for(const auto& fragment : fragments)
+        {
+            if(boxes.size() >= limit) return false;
+            boxes.push_back(fragment);
+        }
+    }
+    return true;
 }
 
