 AC_SUBST([MODULE_BUILDTYPE])
 
 dnl _MODULE_BLOCK_ADD([VAR], [VALUE])
--- base1/Makefile.pre.in	2026-10-25 12:33:47
+++ mod/Makefile.pre.in	2026-10-25 12:35:34
@@ -990,7 +990,7 @@
 
 # Build the interpreter
