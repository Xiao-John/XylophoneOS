 	if test -n "$(DLLLIBRARY)"; then \
 		$(LDSHARED) -Wl,--out-implib=$@ -o $(DLLLIBRARY) $^ \
-			$(LIBS) $(MODLIBS) $(SYSLIBS); \
+			-Wl,--start-group $(LIBS) $(MODLIBS) $(SYSLIBS) -Wl,--end-group; \
 	else true; \
 	fi
 
