@@ -31821,6 +31853,10 @@
     MODULE_BUILDTYPE=${MODULE_BUILDTYPE:-shared}
  ;;
 esac
+
+if test "$ac_sys_system" = XOS; then :
+  MODULE_BUILDTYPE=static
+fi
 
 
 
