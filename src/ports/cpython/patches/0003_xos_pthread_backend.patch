--- a/Python/ceval.c
+++ b/Python/ceval.c
@@ -470,7 +470,13 @@ hardware_stack_limits(uintptr_t *base, uintptr_t *top, uintptr_t sp)
     pthread_attr_t attr;
     int err = pthread_getattr_np(pthread_self(), &attr);
     if (err == 0) {
+#ifdef __xos__
+        /* XOS reports the usable stack range after its unmapped guard page;
+         * the pthread profile therefore has no guard bytes inside that range. */
+        guard_size = 0;
+#else
         err = pthread_attr_getguardsize(&attr, &guard_size);
+#endif
         err |= pthread_attr_getstack(&attr, &stack_addr, &stack_size);
         err |= pthread_attr_destroy(&attr);
     }
--- a/Modules/timemodule.c
+++ b/Modules/timemodule.c
@@ -194,6 +194,8 @@ time_clockid_converter(PyObject *obj, clockid_t *p)
     long long clk_id = PyLong_AsLongLong(obj);
 #elif defined(__DragonFly__)
     long clk_id = PyLong_AsLong(obj);
+#elif defined(__xos__)
+    unsigned long clk_id = PyLong_AsUnsignedLong(obj);
 #else
     int clk_id = PyLong_AsInt(obj);
 #endif
