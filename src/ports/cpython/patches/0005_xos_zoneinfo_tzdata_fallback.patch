From: XOS contributors
Subject: [PATCH] zoneinfo: use tzdata package without importing host sysconfig paths

XOS has no system IANA timezone database. The staged tzdata package is the
fallback source; avoid importing sysconfig just to obtain Unix TZPATH defaults.

--- a/Lib/zoneinfo/_tzpath.py
+++ b/Lib/zoneinfo/_tzpath.py
@@ -1,3 +1,6 @@
 import os
-import sysconfig
+import sys
+
+if sys.platform != "xos":
+    import sysconfig
 
@@ -27,4 +30,7 @@
         env_var = os.environ.get("PYTHONTZPATH", None)
         if env_var is None:
-            env_var = sysconfig.get_config_var("TZPATH")
+            if sys.platform == "xos":
+                env_var = ""
+            else:
+                env_var = sysconfig.get_config_var("TZPATH")
         base_tzpath = _parse_python_tzpath(env_var, stacklevel)
