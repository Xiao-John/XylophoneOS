    We have to make the syscall for both uses of the macro since the
    address might be (and probably is) different.  */
+# ifdef XOS_GLIBC_TLS
+/* The user runtime owns the TCB layout.  XOS installs its address through
+   the explicit current-thread mode of the native process-TLS mechanism. */
+#  define TLS_INIT_TP(thrdescr) \
+  ({ void *_xos_tp = (thrdescr); \
+     tcbhead_t *_xos_head = _xos_tp; \
+     _xos_head->tcb = _xos_tp; \
+     _xos_head->self = _xos_tp; \
+     long _xos_pid, _xos_status; \
+     asm volatile ("int $0x80" : "=a" (_xos_pid) \
+                   : "a" (6UL), "D" (0UL), "S" (0UL), "d" (0UL) : "memory", "cc"); \
+     asm volatile ("int $0x80" : "=a" (_xos_status) \
+                   : "a" (35UL), "D" (_xos_pid), "S" (_xos_tp), "d" (1UL) : "memory", "cc"); \
+     _xos_status == 0; })
+# else
 # define TLS_INIT_TP(thrdescr) \
   ({ void *_thrdescr = (thrdescr);					      \
      tcbhead_t *_head = _thrdescr;					      \
@@ -159,6 +176,8 @@
     _result == 0;							      \
   })
 
+# endif
+
 # define TLS_DEFINE_INIT_TP(tp, pd) void *tp = (pd)
 
 
