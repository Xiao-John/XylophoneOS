-void *
-_dl_allocate_tls_init (void *result, bool main_thread)
+static void *
+allocate_tls_init (void *result, bool main_thread, bool fixed_dtv)
 {
   if (result == NULL)
     /* The memory allocation failed.  */
@@ -633,6 +633,25 @@

   /* Protects global dynamic TLS related state.  */
   __rtld_lock_lock_recursive (GL(dl_load_tls_lock));
+
+#if defined XOS_GLIBC_TLS && !defined SHARED
+  /* A DTV stored in a thread reservation cannot be resized or freed
