   /* Check if the current dtv is big enough.   */
   if (dtv[-1].counter < GL(dl_tls_max_dtv_idx))
@@ -724,7 +743,27 @@

   return result;
 }
+
+void *
+_dl_allocate_tls_init (void *result, bool main_thread)
+{
+  return allocate_tls_init (result, main_thread, false);
+}
 rtld_hidden_def (_dl_allocate_tls_init)
+
+#if defined XOS_GLIBC_TLS && !defined SHARED
+void *__xos_dl_init_reserved_tls (void *, dtv_t *)
+  __attribute__ ((visibility ("hidden")));
+
+void *
+__xos_dl_init_reserved_tls (void *result, dtv_t *dtv)
+{
+  memset (dtv, 0, 3 * sizeof (*dtv));
+  dtv[0].counter = 1;
+  INSTALL_DTV (result, dtv);
+  return allocate_tls_init (result, false, true);
+}
+#endif

