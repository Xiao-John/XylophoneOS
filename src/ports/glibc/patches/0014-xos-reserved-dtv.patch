+                   || GL(dl_tls_dtv_slotinfo_list)->slotinfo[1].map == NULL
+                   || GL(dl_tls_dtv_slotinfo_list)->slotinfo[1].map->l_tls_offset
+                        == NO_TLS_OFFSET
+                   || GL(dl_tls_dtv_slotinfo_list)->slotinfo[1].map->l_tls_offset
+                        == FORCED_DYNAMIC_TLS_OFFSET))
+    {
+      __rtld_lock_unlock_recursive (GL(dl_load_tls_lock));
+      return NULL;
+    }
