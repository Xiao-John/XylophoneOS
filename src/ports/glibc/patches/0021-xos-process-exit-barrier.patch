--- a/stdlib/exit.c
+++ b/stdlib/exit.c
@@ -22,6 +22,9 @@
 #include <libc-lock.h>
 #include <set-freeres.h>
 #include "exit.h"
+#ifdef XOS_GLIBC_TLS
+# include <pthreadP.h>
