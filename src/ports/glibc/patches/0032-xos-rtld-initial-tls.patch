+#ifdef XOS_RTLD_CLOSED_DEPENDENCIES
+/* Publish the real dispatcher after self-relocation and before invoking
+   the OS entry, while the ELF RELRO data is still writable.  */
+static void
+xos_init_rtld_dispatch (void)
+{
+  GLRO (dl_debug_printf) = _dl_debug_printf;
+  GLRO (dl_mcount) = _dl_mcount;
+  GLRO (dl_lookup_symbol_x) = _dl_lookup_symbol_x;
+  GLRO (dl_open) = _dl_open;
+  GLRO (dl_close) = _dl_close;
+  GLRO (dl_catch_error) = _dl_catch_error;
+  GLRO (dl_error_free) = _dl_error_free;
+  GLRO (dl_tls_get_addr_soft) = _dl_tls_get_addr_soft;
+  GLRO (dl_libc_freeres) = __rtld_libc_freeres;
+}
+#endif
@@ -452,0 +479,3 @@
