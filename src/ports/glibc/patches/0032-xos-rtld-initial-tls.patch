+#ifndef XOS_RTLD_CLOSED_DEPENDENCIES
+static
+#endif
+void
+init_tls_templates (struct link_map *main_map, void *tcbp)
+{
+  unsigned int i = main_map->l_searchlist.r_nlist;
+  while (i-- > 0)
+    {
+      struct link_map *l = main_map->l_initfini[i];
+      if (l->l_tls_blocksize != 0)
+        _dl_add_to_slotinfo (l, true);
+    }
+  /* _dl_add_to_slotinfo records gen = dl_tls_generation + 1.  */
+  if (GL(dl_tls_max_dtv_idx) > 0)
+    ++GL(dl_tls_generation);
+  _dl_allocate_tls_init (tcbp, true);
@@ -2258,3 +2319 @@
