--- a/dlfcn/dlclose.c
+++ b/dlfcn/dlclose.c
@@ -20,10 +20,25 @@
 #include <ldsodefs.h>
 #include <shlib-compat.h>
 
+#ifdef XOS_DLFUNC_FIXED_CLOSURE
+# include <xos_dlfcn_policy.h>
+#endif
+
 int
 __dlclose (void *handle)
 {
 #ifdef SHARED
+#if defined XOS_DLFUNC_FIXED_CLOSURE && defined XOS_ONLINE_CLOSURE
+  struct xos_dlfcn_request request = { NULL, LM_ID_BASE, 0, 1 };
+  if (_dlerror_run (__xos_dlfcn_begin, &request))
+    return -1;
+  int result = _dlerror_run (GLRO (dl_close), handle) ? -1 : 0;
+  __xos_rtld_online_end ();
+  return result;
+#elif defined XOS_DLFUNC_FIXED_CLOSURE
+  _dlerror_run (__xos_dlfcn_unsupported, NULL);
+  return -1;
+#endif
   if (GLRO (dl_dlfcn_hook) != NULL)
     return GLRO (dl_dlfcn_hook)->dlclose (handle);
 #endif
