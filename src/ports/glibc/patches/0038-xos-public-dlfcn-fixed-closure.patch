--- a/dlfcn/dlopen.c
+++ b/dlfcn/dlopen.c
@@ -22,6 +22,10 @@
 #include <unistd.h>
 #include <ldsodefs.h>
 #include <shlib-compat.h>
+
+#ifdef XOS_DLFUNC_FIXED_CLOSURE
+# include <xos_dlfcn_policy.h>
+#endif
 
 struct dlopen_args
 {
@@ -75,6 +79,17 @@
 void *
 ___dlopen (const char *file, int mode)
 {
+#if defined XOS_DLFUNC_FIXED_CLOSURE && defined XOS_ONLINE_CLOSURE
+  struct xos_dlfcn_request request = { file, LM_ID_BASE, mode, 0 };
+  if (_dlerror_run (__xos_dlfcn_begin, &request))
+    return NULL;
+  void * result = dlopen_implementation (file, mode, RETURN_ADDRESS (0));
+  __xos_rtld_online_end ();
+  return result;
+#elif defined XOS_DLFUNC_FIXED_CLOSURE
+  _dlerror_run (__xos_dlfcn_unsupported, NULL);
+  return NULL;
+#endif
   if (GLRO (dl_dlfcn_hook) != NULL)
     return GLRO (dl_dlfcn_hook)->dlopen (file, mode, RETURN_ADDRESS (0));
   else
