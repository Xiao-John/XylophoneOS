 /* The set of signals that are caught.  */
 static sigset_t caught_signals;
+
+/* XOS has no asynchronous signals.  Other targets retain the original
+   signal masks around output cleanup.  These are private gzip operations,
+   not replacement POSIX functions reporting fake success.  */
+static void
+block_cleanup_signals (sigset_t *oldset)
+{
+#ifndef __xos__
+  sigprocmask (SIG_BLOCK, &caught_signals, oldset);
+#else
+  (void) oldset;
+#endif
+}
+
+static void
+restore_cleanup_signals (sigset_t const *oldset)
+{
+#ifndef __xos__
+  sigprocmask (SIG_SETMASK, oldset, NULL);
+#else
+  (void) oldset;
+#endif
+}
 
