 /* Private NO_SYS control. Only the owner of the resolver loop may use it
  * outside callbacks. Cancellation never calls client code. */
 u8_t
@@ -1174,6 +1209,9 @@ dns_check_entry(u8_t i)
           } else {
             LWIP_DEBUGF(DNS_DEBUG, ("dns_check_entry: \"%s\": timeout\n", entry->name));
             /* call specified callback function if provided */
+#ifdef XOS_LWIP_DNS_LIFETIME
