+#ifdef XOS_LWIP_DNS_LIFETIME
+/* Validate names in sections used only to delimit a negative response. No
+ * record in those sections is promoted into an answer or cached. */
+static u16_t
+dns_skip_wire_name(const struct pbuf *p, u16_t cursor)
+{
+  u16_t end = 0, expanded = 1;
+  u8_t pointers = 0;
+  while (cursor < p->tot_len) {
+    int length = pbuf_try_get_at(p, cursor++);
+    if (length == 0) {
+      return end ? end : cursor;
+    }
+    if (length < 0) {
+      break;
+    }
+    if ((length & 0xc0) == 0xc0) {
+      const int next = pbuf_try_get_at(p, cursor);
+      if (next < 0 || ++pointers > 16) {
+        break;
+      }
+      const u16_t target = (u16_t)(((length & 0x3f) << 8) | next);
+      if (target < SIZEOF_DNS_HDR || target >= cursor - 1) {
+        break;
+      }
+      if (!end) {
+        end = (u16_t)(cursor + 1);
+      }
+      cursor = target;
+    } else {
+      expanded = (u16_t)(expanded + length + 1);
+      if (length > 63 || expanded > 255 || (u32_t)cursor + length >= p->tot_len) {
+        break;
+      }
+      cursor = (u16_t)(cursor + length);
+    }
+  }
+  return 0;
+}
+
+static int
+dns_negative_sections_valid(const struct pbuf *p, u16_t cursor, u16_t authority,
+                            u16_t additional, int *referral)
+{
+  struct dns_answer record;
+  const u32_t records = (u32_t)authority + additional;
+  int has_ns = 0, has_soa = 0;
+  if (records > 45) {
+    return 0;
+  }
+  for (u32_t i = 0; i < records; ++i) {
+    cursor = dns_skip_wire_name(p, cursor);
+    if (!cursor || pbuf_copy_partial(p, &record, SIZEOF_DNS_ANSWER, cursor) != SIZEOF_DNS_ANSWER) {
+      return 0;
+    }
+    const u32_t next = (u32_t)cursor + SIZEOF_DNS_ANSWER + lwip_ntohs(record.len);
+    if (next > p->tot_len) {
+      return 0;
+    }
+    if (i < authority && lwip_ntohs(record.cls) == DNS_RRCLASS_IN) {
+      const u16_t type = lwip_ntohs(record.type);
+      has_ns |= type == DNS_RRTYPE_NS;
+      has_soa |= type == DNS_RRTYPE_SOA;
+    }
+    cursor = (u16_t)next;
+  }
+  /* RFC 2308 section 2.2 distinguishes a referral from NODATA. */
+  *referral = has_ns && !has_soa;
+  return cursor == p->tot_len;
+}
+#endif
+
 /**
  * Receive input function for DNS response packets arriving for the dns UDP pcb.
  */
@@ -1339,8 +1450,11 @@ dns_recv(void *arg, struct udp_pcb *pcb, struct pbuf *p, const ip_addr_t *addr,
 
         /* Check for correct response. */
         if (((hdr.flags1 & DNS_FLAG1_RESPONSE) == 0) ||
-            ((hdr.flags1 & DNS_FLAG1_OPCODE_MASK) != DNS_FLAG1_OPCODE_STANDARD) ||
-            ((hdr.flags1 & DNS_FLAG1_TRUNC) != 0)) {
+            ((hdr.flags1 & DNS_FLAG1_OPCODE_MASK) != DNS_FLAG1_OPCODE_STANDARD)
+#ifndef XOS_LWIP_DNS_LIFETIME
+            || ((hdr.flags1 & DNS_FLAG1_TRUNC) != 0)
+#endif
+            ) {
           LWIP_DEBUGF(DNS_DEBUG, ("dns_recv: \"%s\": not a complete QUERY response\n", entry->name));
           goto ignore_packet; /* ignore this packet */
         }
@@ -1396,6 +1510,25 @@ dns_recv(void *arg, struct udp_pcb *pcb, struct pbuf *p, const ip_addr_t *addr,
         }
         res_idx = (u16_t)(res_idx + SIZEOF_DNS_QUERY);
 
+#ifdef XOS_LWIP_DNS_LIFETIME
+        if ((hdr.flags1 & DNS_FLAG1_TRUNC) != 0) {
+          entry->result = DNS_XOS_TRUNCATED;
+          goto complete_negative;
+        }
+        if ((hdr.flags2 & DNS_FLAG2_ERR_MASK) || !nanswers) {
+          int referral;
+          if (nanswers || !dns_negative_sections_valid(p, res_idx, lwip_ntohs(hdr.numauthrr),
+                                                      lwip_ntohs(hdr.numextrarr), &referral)) {
+            goto ignore_packet;
+          }
+          switch (hdr.flags2 & DNS_FLAG2_ERR_MASK) {
+            case 0: entry->result = referral ? DNS_XOS_FAILURE : DNS_XOS_NO_DATA; goto complete_negative;
+            case DNS_FLAG2_ERR_NAME: entry->result = DNS_XOS_NOT_FOUND; goto complete_negative;
+            case 5: entry->result = DNS_XOS_REFUSED; goto complete_negative;
+            default: entry->result = DNS_XOS_FAILURE; goto complete_negative;
+          }
+        }
+#endif
         /* Check for error. If so, call callback to inform. */
         if (hdr.flags2 & DNS_FLAG2_ERR_MASK) {
           LWIP_DEBUGF(DNS_DEBUG, ("dns_recv: \"%s\": error in flags\n", entry->name));
@@ -1524,6 +1657,9 @@ next_answer:
 #endif /* LWIP_IPV4 && LWIP_IPV6 */
           LWIP_DEBUGF(DNS_DEBUG, ("dns_recv: \"%s\": error in response\n", entry->name));
         }
+#ifdef XOS_LWIP_DNS_LIFETIME
+complete_negative:
+#endif
         /* call callback to indicate error, clean up memory and return */
         pbuf_free(p);
         dns_call_found(i, NULL);
@@ -1652,6 +1788,11 @@ dns_enqueue(const char *name, size_t hostnamelen, dns_found_callback found,
   /* fill the entry */
   entry->state = DNS_STATE_NEW;
   entry->seqno = dns_seqno;
+#ifdef XOS_LWIP_DNS_LIFETIME
+  entry->result = DNS_XOS_FAILURE;
+  entry->ttl = 0;
+  entry->expiry_ns = 0;
+#endif
   LWIP_DNS_SET_ADDRTYPE(entry->reqaddrtype, dns_addrtype);
   LWIP_DNS_SET_ADDRTYPE(req->reqaddrtype, dns_addrtype);
   req->found = found;
