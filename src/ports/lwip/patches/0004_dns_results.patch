--- a/src/core/dns.c
+++ b/src/core/dns.c
@@ -236,6 +236,7 @@ struct dns_table_entry {
 #ifdef XOS_LWIP_DNS_LIFETIME
   uint64_t expiry_ns;
   uint64_t retry_ns;
+  enum dns_xos_status result;
 #endif
   ip_addr_t ipaddr;
   u16_t txid;
@@ -1005,6 +1006,40 @@ dns_call_found(u8_t idx, ip_addr_t *addr)
 }
 
 #ifdef XOS_LWIP_DNS_LIFETIME
+/* Callback metadata is available only during the call that lends this name. */
+enum dns_xos_status
+dns_xos_callback_status(const char *callback_name, uint64_t *expiry)
+{
+  u8_t i;
+  *expiry = 0;
+  for (i = 0; i < DNS_TABLE_SIZE; ++i) {
+    if (callback_name == dns_table[i].name) {
+      *expiry = dns_table[i].ttl ? dns_table[i].expiry_ns : 0;
+      return dns_table[i].result;
+    }
+  }
+  return DNS_XOS_FAILURE;
+}
+
+err_t
+dns_xos_cache_expiry(const char *name, uint64_t *expiry)
+{
+  uint64_t now;
+  u8_t i;
+  if (xos_lwip_dns_clock(&now) != ERR_OK) {
+    return ERR_IF;
+  }
+  for (i = 0; i < DNS_TABLE_SIZE; ++i) {
+    const struct dns_table_entry *entry = &dns_table[i];
+    if (entry->state == DNS_STATE_DONE && entry->ttl && now < entry->expiry_ns &&
+        lwip_stricmp(name, entry->name) == 0) {
+      *expiry = entry->expiry_ns;
+      return ERR_OK;
+    }
+  }
+  return ERR_VAL;
+}
