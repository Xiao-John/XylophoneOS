# Experimental QtBase cross-configuration; XOS_SDK must be a matching threading SDK.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
set(CMAKE_SYSTEM_NAME XOS)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XOS_SDK XOS_BINUTILS_DIR)
if(NOT DEFINED XOS_SDK OR NOT EXISTS "${XOS_SDK}/manifest.json")
  message(FATAL_ERROR "Set XOS_SDK to a built, version-matched XOS threading SDK")
endif()
if(NOT DEFINED XOS_BINUTILS_DIR OR NOT EXISTS "${XOS_BINUTILS_DIR}/as" OR NOT EXISTS "${XOS_BINUTILS_DIR}/ld")
  message(FATAL_ERROR "Set XOS_BINUTILS_DIR to a directory containing the target as and ld")
endif()
get_filename_component(XOS_SDK "${XOS_SDK}" ABSOLUTE)
set(CMAKE_C_COMPILER x86_64-elf-gcc)
set(CMAKE_CXX_COMPILER x86_64-elf-g++)
set(CMAKE_AR x86_64-elf-ar)
set(CMAKE_RANLIB x86_64-elf-ranlib)
set(CMAKE_FIND_ROOT_PATH "${XOS_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_xos_flags "-B${XOS_BINUTILS_DIR}/ -mno-red-zone -fno-pic -fno-pie -fno-stack-protector -ftls-model=local-exec -D__XOS__ -DXOS_THREADED_RUNTIME -D_POSIX_C_SOURCE=200809L")
set(CMAKE_C_FLAGS_INIT "${_xos_flags} -DPCRE2_DISABLE_JIT -I${XOS_SDK}/include")
set(CMAKE_CXX_FLAGS_INIT "${_xos_flags} -nostdinc++ -I${XOS_SDK}/cpp/include -I${XOS_SDK}/cpp/include/x86_64-elf -I${XOS_SDK}/include")
# CMake's architecture probe links an executable even when try_compile is static.
# Use the actual XOS CRT and archives; no host libc or synthetic link success.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -static -no-pie -Wl,--build-id=none,--no-undefined,-z,noexecstack,-z,max-page-size=4096 -T${XOS_SDK}/user.ld ${XOS_SDK}/crt0_posix.o")
set(_xos_libraries "-Wl,--start-group -Wl,--whole-archive ${XOS_SDK}/lib/libxos.a -Wl,--no-whole-archive ${XOS_SDK}/cpp/lib/libstdc++.a ${XOS_SDK}/cpp/lib/libsupc++.a ${XOS_SDK}/lib/libc.a ${XOS_SDK}/lib/libm.a ${XOS_SDK}/cpp/lib/libgcc.a -Wl,--end-group")
set(CMAKE_C_STANDARD_LIBRARIES_INIT "${_xos_libraries}")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "${_xos_libraries}")
