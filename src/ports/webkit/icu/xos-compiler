#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -eu

sdk=$XOS_ICU_SDK
lib=$sdk/usr/lib
flags=(--sysroot="$sdk" -mno-red-zone -fno-pie -fno-pic -ftls-model=local-exec
       -D__XOS__ -D_GNU_SOURCE=1 -nostdinc)
runtime=("$lib/libc.a" "$lib/libm.a" "$lib/libxos_terminal.a" "$lib/libgcc.a")
if [[ ${0##*/} == cxx ]]; then
    compiler=$XOS_ICU_CXX
    flags+=(-nostdinc++)
    while IFS= read -r path; do
        flags+=(-isystem "$sdk/$path")
    done < "$XOS_ICU_CXX_INCLUDES"
    runtime+=("$lib/libstdc++.a" "$lib/libsupc++.a")
else
    compiler=$XOS_ICU_CC
fi
flags+=(-isystem "$sdk/usr/include" -isystem "$lib/compiler-include")

for arg in "$@"; do
    case $arg in
        -c|-E|-S|-M|-MM|-fsyntax-only|--version|-dump*|-print*|-V|-qversion|-version)
            exec "$compiler" "${flags[@]}" "$@" ;;
    esac
done
if [[ $# == 1 && $1 == -v ]]; then
    exec "$compiler" -v
fi
exec "$compiler" "${flags[@]}" -static -no-pie -nostdlib \
    -Wl,--build-id=none,-z,noexecstack,-z,max-page-size=4096 -T "$sdk/user.ld" \
    "$lib/xos_start.o" "$lib/crti.o" "$lib/crtbegin.o" "$lib/xos_start_c.o" "$@" \
    -Wl,--start-group "${runtime[@]}" -Wl,--end-group "$lib/crtend.o" "$lib/crtn.o"
