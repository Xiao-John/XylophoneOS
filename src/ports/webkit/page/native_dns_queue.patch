+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "DNSResolveQueue.h"
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <wtf/CompletionHandler.h>
+#include <wtf/RefPtr.h>
+#include <wtf/WorkQueue.h>
+
+namespace WebCore {
+
+class DNSResolveQueueXOS final : public DNSResolveQueue {
+public:
+    bool configureService(uint64_t);
+    void resolve(const String&, uint64_t, DNSCompletionHandler&&) final;
+    void stopResolve(uint64_t) final;
+
+private:
+    struct Request {
+        Request(uint64_t id, DNSCompletionHandler&& handler)
+            : identifier(id)
+            , completion(WTF::move(handler))
+        {
+        }
+
+        uint64_t identifier;
+        DNSCompletionHandler completion;
+        std::atomic<bool> cancelled { false };
+    };
+
+    void updateIsUsingProxy() final;
+    void platformResolve(const String&) final;
+    bool schedule(const String&, std::shared_ptr<Request>);
+    void didResolve(std::shared_ptr<Request>, std::optional<uint32_t>);
+
+    RefPtr<WorkQueue> m_worker;
+    std::unordered_map<uint64_t, std::shared_ptr<Request>> m_requests;
+    uint64_t m_servicePID { 0 };
+    unsigned m_pending { 0 };
+};
+
+using DNSResolveQueuePlatform = DNSResolveQueueXOS;
+
+} // namespace WebCore
