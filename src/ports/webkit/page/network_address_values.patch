+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace WebCore::XOSIPAddress {
+
+using IPv4 = std::array<uint8_t, 4>;
+using IPv6 = std::array<uint8_t, 16>;
+
+inline std::optional<IPv4> parseIPv4(std::string_view literal)
+{
+    IPv4 address { };
+    for (size_t index = 0; index < address.size(); ++index) {
+        const auto separator = literal.find('.');
+        const auto octet = literal.substr(0, separator);
+        if (octet.empty() || octet.size() > 3 || (octet.size() > 1 && octet.front() == '0'))
+            return std::nullopt;
+        unsigned number = 0;
+        for (auto digit : octet) {
+            if (digit < '0' || digit > '9')
+                return std::nullopt;
+            number = 10 * number + static_cast<unsigned>(digit - '0');
+        }
+        if (number > 255 || ((separator == std::string_view::npos) != (index + 1 == address.size())))
+            return std::nullopt;
+        address[index] = static_cast<uint8_t>(number);
+        if (separator != std::string_view::npos)
+            literal.remove_prefix(separator + 1);
+    }
+    return address;
+}
+
+inline std::optional<IPv6> parseIPv6(std::string_view literal)
+{
+    std::array<uint16_t, 8> groups { };
+    size_t count = 0;
+    std::optional<size_t> compression;
+    if (literal.starts_with("::")) {
+        compression = 0;
+        literal.remove_prefix(2);
+    }
+    while (!literal.empty()) {
+        if (count == groups.size())
+            return std::nullopt;
+        const auto separator = literal.find(':');
+        const auto group = literal.substr(0, separator);
+        if (group.find('.') != std::string_view::npos) {
+            const auto ipv4 = parseIPv4(group);
+            if (!ipv4 || separator != std::string_view::npos || count > groups.size() - 2)
+                return std::nullopt;
+            groups[count++] = ((*ipv4)[0] << 8) | (*ipv4)[1];
+            groups[count++] = ((*ipv4)[2] << 8) | (*ipv4)[3];
+            break;
+        }
+        if (group.empty() || group.size() > 4)
+            return std::nullopt;
+        uint16_t number = 0;
+        for (char digit : group) {
+            unsigned value;
+            if (digit >= '0' && digit <= '9')
+                value = static_cast<unsigned>(digit - '0');
+            else if (digit >= 'a' && digit <= 'f')
+                value = 10 + static_cast<unsigned>(digit - 'a');
+            else if (digit >= 'A' && digit <= 'F')
+                value = 10 + static_cast<unsigned>(digit - 'A');
+            else
+                return std::nullopt;
+            number = static_cast<uint16_t>((number << 4) | value);
+        }
+        groups[count++] = number;
+        if (separator == std::string_view::npos)
+            break;
+        if (literal.substr(separator).starts_with("::")) {
+            if (compression)
+                return std::nullopt;
+            compression = count;
+            literal.remove_prefix(separator + 2);
+        } else {
+            literal.remove_prefix(separator + 1);
+            if (literal.empty())
+                return std::nullopt;
+        }
+    }
+    if (compression) {
+        if (count == groups.size())
+            return std::nullopt;
+        const size_t omitted = groups.size() - count;
+        std::move_backward(groups.begin() + *compression, groups.begin() + count, groups.end());
+        std::fill_n(groups.begin() + *compression, omitted, 0);
+    } else if (count != groups.size())
+        return std::nullopt;
+
+    IPv6 address { };
+    for (size_t index = 0; index < groups.size(); ++index) {
+        address[2 * index] = static_cast<uint8_t>(groups[index] >> 8);
+        address[2 * index + 1] = static_cast<uint8_t>(groups[index]);
+    }
+    return address;
+}
+
+} // namespace WebCore::XOSIPAddress
