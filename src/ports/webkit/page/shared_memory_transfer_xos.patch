+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "SharedMemory.h"
+
+#if OS(XOS)
+#include <xos/process_abi.hpp>
+
+namespace WebCore {
+
+struct xos_shared_memory_route {
+    xos::ipc_channel endpoints;
+    uint64_t expected_peer;
+    uint64_t exchange;
+};
+
+enum class xos_loan_result {
+    ok,
+    local_views_active,
+    exchange_unconfirmed,
+};
+
+// The route is a dedicated lane between explicitly trusted processes. Callers
+// retain the offer until closure is confirmed or the supervised peer has exited.
+class xos_memory_offer final {
+public:
+    static std::optional<xos_memory_offer> send(SharedMemoryHandle&&, const xos_shared_memory_route&, uint64_t deadline);
+
+    xos_memory_offer(xos_memory_offer&&) = default;
+    xos_memory_offer(const xos_memory_offer&) = delete;
+    bool published() const { return m_published; }
+
+    bool confirm_map(uint64_t deadline);
+    xos_loan_result close_after_release(uint64_t deadline);
+
+    // Management closure invalidates all mappings. Use after the borrower
+    // released, after its confirmed exit, or before any mapping was published.
+    xos_loan_result revoke();
+
+private:
+    xos_memory_offer(RefPtr<xos_memory_grant>&&, const xos_shared_memory_route&, size_t, SharedMemoryProtection, bool);
+    RefPtr<xos_memory_grant> m_grant;
+    xos_shared_memory_route m_route;
+    uint64_t m_number;
+    uint64_t m_length;
+    SharedMemoryProtection m_protection;
+    bool m_published;
+    bool m_confirmed { false };
+    bool m_peer_released { false };
+    bool m_closed { false };
+    bool m_close_reported { false };
+};
+
+class xos_memory_loan final {
+public:
+    static std::optional<xos_memory_loan> receive(const xos_shared_memory_route&, SharedMemoryProtection, uint64_t deadline);
+
+    xos_memory_loan(xos_memory_loan&&) = default;
+    xos_memory_loan(const xos_memory_loan&) = delete;
+
+    RefPtr<SharedMemory> view() const { return m_view; }
+    xos_loan_result release(uint64_t deadline);
+    bool confirm_close(uint64_t deadline);
+
+private:
+    xos_memory_loan(RefPtr<xos_memory_grant>&&, RefPtr<SharedMemory>&&, const xos_shared_memory_route&,
+        uint64_t, uint64_t, SharedMemoryProtection);
+    RefPtr<xos_memory_grant> m_grant;
+    RefPtr<SharedMemory> m_view;
+    xos_shared_memory_route m_route;
+    uint64_t m_number;
+    uint64_t m_length;
+    SharedMemoryProtection m_protection;
+    bool m_released { false };
+};
+
+}
