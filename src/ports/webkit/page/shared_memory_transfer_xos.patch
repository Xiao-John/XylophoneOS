+namespace {
+
+constexpr uint32_t transfer_magic = 0x314d5358; // XSM1
+enum class transfer_step : uint8_t { offer = 1, mapped, released, closed };
+
+struct transfer_record {
+    uint32_t magic;
+    uint8_t version;
+    uint8_t step;
+    uint8_t protection;
+    uint8_t reserved;
+    uint64_t exchange;
+    uint64_t grant;
+    uint64_t size;
+};
+static_assert(sizeof(transfer_record) == 32);
+
+bool authenticated_route(const xos_shared_memory_route& route)
+{
+    const auto [send, receive] = route.endpoints;
+    xos::u64 sender = 0, receiver = 0;
+    return send && receive && send != receive && route.expected_peer && route.exchange
+        && !xos::sdk::ipc_endpoint_peer(send, sender) && !xos::sdk::ipc_endpoint_peer(receive, receiver)
+        && sender == route.expected_peer && receiver == route.expected_peer;
+}
+
+bool wait_for_record(uint64_t deadline)
+{
+    const auto now = xos::thread::clock();
+    return now < deadline && !xos::thread::sleep_until(now + std::min(deadline - now, uint64_t { 1'000'000 }));
+}
+
+bool send_record(const xos_shared_memory_route& route, transfer_step step, uint64_t grant, uint64_t size,
+    SharedMemoryProtection protection, uint64_t deadline)
+{
+    const transfer_record packet { transfer_magic, 1, static_cast<uint8_t>(step), static_cast<uint8_t>(protection),
+        0, route.exchange, grant, size };
+    while (authenticated_route(route)) {
+        const auto result = xos::sdk::ipc_send(route.endpoints.send, &packet, sizeof(packet));
+        if (!result)
+            return true;
+        // Each endpoint holds one pending message. In particular, a borrower
+        // can finish its work before the owner consumes the mapped receipt.
+        if (result != xos::ipc_error_full || !wait_for_record(deadline))
+            return false;
+    }
+    return false;
+}
+
+bool receive_record(const xos_shared_memory_route& route, transfer_step step, uint64_t deadline, transfer_record& packet)
+{
+    while (authenticated_route(route)) {
+        const auto size = xos::sdk::ipc_recv(route.endpoints.receive, &packet, sizeof(packet));
+        if (size == static_cast<xos::i64>(sizeof(packet)))
+            return authenticated_route(route) && packet.magic == transfer_magic && packet.version == 1
+                && packet.step == static_cast<uint8_t>(step) && !packet.reserved && packet.exchange == route.exchange
+                && packet.grant && packet.size && packet.size <= grant_limit
+                && packet.protection <= static_cast<uint8_t>(SharedMemoryProtection::ReadWrite);
+        if (size != xos::process_error_would_block || !wait_for_record(deadline))
+            return false;
+    }
+    return false;
+}
+
+bool receive_reply(const xos_shared_memory_route& route, transfer_step step, uint64_t deadline,
+    uint64_t number, uint64_t length, SharedMemoryProtection protection)
+{
+    transfer_record reply { };
+    return receive_record(route, step, deadline, reply) && reply.grant == number && reply.size == length
+        && reply.protection == static_cast<uint8_t>(protection);
+}
+
+}
+
+xos_memory_offer::xos_memory_offer(RefPtr<xos_memory_grant>&& grant, const xos_shared_memory_route& route, size_t length,
+    SharedMemoryProtection protection, bool published)
+    : m_grant(WTF::move(grant))
+    , m_route(route)
+    , m_number(m_grant->m_handle)
+    , m_length(length)
+    , m_protection(protection)
+    , m_published(published)
+{
+}
+
+std::optional<xos_memory_offer> xos_memory_offer::send(SharedMemoryHandle&& handle, const xos_shared_memory_route& route, uint64_t deadline)
+{
+    auto& storage = handle.m_handle;
+    if (!storage || !storage.m_grant->m_transferable || !authenticated_route(route))
+        return std::nullopt;
+    auto& grant = *storage.m_grant;
+    if (grant.m_exported.exchange(true))
+        return std::nullopt;
+
+    auto rights = static_cast<uint32_t>(xos::ipc_v1_grant_right::read_mapping);
+    if (storage.m_protection == SharedMemoryProtection::ReadWrite)
+        rights |= static_cast<uint32_t>(xos::ipc_v1_grant_right::write_mapping);
+    xos::u64 delegated = 0;
+    if (xos::ipc_v1::grant_delegate(grant.m_handle, route.expected_peer, rights, delegated)) {
+        grant.m_exported.store(false);
+        return std::nullopt;
+    }
+    RELEASE_ASSERT(delegated == grant.m_handle);
+
+    const auto published = send_record(route, transfer_step::offer, delegated, handle.size(), storage.m_protection, deadline);
+    return xos_memory_offer(WTF::move(storage.m_grant), route, handle.size(), storage.m_protection, published);
+}
+
+bool xos_memory_offer::confirm_map(uint64_t deadline)
+{
+    if (!m_grant || !m_published || m_confirmed)
+        return false;
+    m_confirmed = receive_reply(m_route, transfer_step::mapped, deadline, m_number, m_length, m_protection);
+    return m_confirmed;
+}
+
+xos_loan_result xos_memory_offer::revoke()
+{
+    if (!m_grant)
+        return xos_loan_result::exchange_unconfirmed;
+    if (!m_grant->hasOneRef())
+        return xos_loan_result::local_views_active;
+    if (xos::ipc_v1::grant_close(m_number))
+        return xos_loan_result::exchange_unconfirmed;
+    m_grant->m_handle = 0;
+    m_grant = nullptr;
+    m_closed = true;
+    return xos_loan_result::ok;
+}
+
+xos_loan_result xos_memory_offer::close_after_release(uint64_t deadline)
+{
+    if (m_close_reported)
+        return xos_loan_result::ok;
+    if (!m_confirmed)
+        return xos_loan_result::exchange_unconfirmed;
+    if (!m_peer_released)
+        m_peer_released = receive_reply(m_route, transfer_step::released, deadline, m_number, m_length, m_protection);
+    if (!m_peer_released)
+        return xos_loan_result::exchange_unconfirmed;
+    if (!m_closed) {
+        const auto result = revoke();
+        if (result != xos_loan_result::ok)
+            return result;
+    }
+    m_close_reported = send_record(m_route, transfer_step::closed, m_number, m_length, m_protection, deadline);
+    return m_close_reported ? xos_loan_result::ok : xos_loan_result::exchange_unconfirmed;
+}
+
+xos_memory_loan::xos_memory_loan(RefPtr<xos_memory_grant>&& grant, RefPtr<SharedMemory>&& view, const xos_shared_memory_route& route,
+    uint64_t number, uint64_t length, SharedMemoryProtection protection)
+    : m_grant(WTF::move(grant))
+    , m_view(WTF::move(view))
+    , m_route(route)
+    , m_number(number)
+    , m_length(length)
+    , m_protection(protection)
+{
+}
+
+std::optional<xos_memory_loan> xos_memory_loan::receive(const xos_shared_memory_route& route, SharedMemoryProtection protection,
+    uint64_t deadline)
+{
+    transfer_record packet { };
+    if (!receive_record(route, transfer_step::offer, deadline, packet)
+        || packet.protection != static_cast<uint8_t>(protection))
+        return std::nullopt;
+
+    RefPtr<xos_memory_grant> grant = adoptRef(*new xos_memory_grant(packet.grant, false, false));
+    auto handle = SharedMemoryHandle(SharedMemoryHandle::Type(Ref { *grant }, protection), packet.size);
+    auto view = SharedMemory::map(WTF::move(handle), protection);
+    if (!view || !send_record(route, transfer_step::mapped, packet.grant, packet.size, protection, deadline))
+        return std::nullopt;
+
+    return xos_memory_loan(WTF::move(grant), WTF::move(view), route, packet.grant, packet.size, protection);
+}
+
+xos_loan_result xos_memory_loan::release(uint64_t deadline)
+{
+    if (!m_grant || m_released)
+        return xos_loan_result::exchange_unconfirmed;
+    m_view = nullptr;
+    if (!m_grant->hasOneRef())
+        return xos_loan_result::local_views_active;
+    m_released = send_record(m_route, transfer_step::released, m_number, m_length, m_protection, deadline);
+    return m_released ? xos_loan_result::ok : xos_loan_result::exchange_unconfirmed;
+}
+
+bool xos_memory_loan::confirm_close(uint64_t deadline)
+{
+    if (!m_grant || !m_released
+        || !receive_reply(m_route, transfer_step::closed, deadline, m_number, m_length, m_protection))
+        return false;
+    m_grant = nullptr;
+    return true;
 }

 } // namespace WebCore
