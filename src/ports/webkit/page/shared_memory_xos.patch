+// SPDX-License-Identifier: Apache-2.0
+#include "config.h"
+#include "SharedMemory.h"
+
+#if OS(XOS)
+#include <xos/ipc_v1.hpp>
+#include <xos/vm_abi.hpp>
+#include <wtf/Assertions.h>
+
+namespace WebCore {
+namespace {
+
+constexpr auto grant_limit = uint64_t { xos::ipc_v1_max_grant_pages } * xos::vm_page_size;
+constexpr auto mapping_stride = grant_limit + xos::vm_page_size;
+constexpr auto local_rights = static_cast<uint32_t>(xos::ipc_v1_grant_right::read_mapping)
+    | static_cast<uint32_t>(xos::ipc_v1_grant_right::write_mapping)
+    | static_cast<uint32_t>(xos::ipc_v1_grant_right::manage);
+
+}
+
+xos_memory_grant::~xos_memory_grant()
+{
+    // A live local mapping owns a strong reference. Destruction therefore has
+    // no live users to keep pages pinned.
+    RELEASE_ASSERT(!xos::ipc_v1::grant_close(m_handle));
+}
+
+RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
+{
+    if (!size || size > grant_limit)
+        return nullptr;
+
+    xos::u64 grant = 0;
+    xos::u64 length = 0;
+    if (xos::ipc_v1::grant_create(0, size, local_rights, grant, length))
+        return nullptr;
+
+    auto storage = adoptRef(*new xos_memory_grant(grant));
+    if (length != size)
+        return nullptr;
+
+    return map(Handle(Handle::Type(WTF::move(storage), Protection::ReadWrite), size), Protection::ReadWrite);
+}
+
+RefPtr<SharedMemory> SharedMemory::map(Handle&& handle, Protection protection, CopyOnWrite copy_on_write)
+{
+    auto storage = WTF::move(handle.m_handle);
+    const auto size = handle.size();
+    if (!storage || !size || size > grant_limit || copy_on_write == CopyOnWrite::Yes
+        || (protection == Protection::ReadWrite && storage.m_protection != Protection::ReadWrite))
+        return nullptr;
+
+    const auto access = protection == Protection::ReadWrite ? xos::ipc_v1_grant_access::read_write : xos::ipc_v1_grant_access::read;
+    const auto grant = storage.m_grant->m_handle;
+    // Address selection and reservation happen in one grant_map call. Gaps
+    // between candidates keep our reservations separately releasable.
+    for (uint64_t index = 1; index <= 2 * xos::ipc_v1_max_grant_mappings_system; ++index) {
+        const auto address = xos::vm_arena_end - index * mapping_stride;
+        xos::u64 mapping = 0;
+        xos::u64 length = 0;
+        const auto result = xos::ipc_v1::grant_map(grant, address, access, mapping, length);
+        if (result == static_cast<xos::i64>(xos::ipc_v1_error::address))
+            continue;
+        if (result)
+            return nullptr;
+        RELEASE_ASSERT(mapping);
+        if (length != size) {
+            RELEASE_ASSERT(!xos::ipc_v1::grant_unmap(grant, mapping));
+            return nullptr;
+        }
+
+        auto memory = adoptRef(*new SharedMemory);
+        memory->m_size = size;
+        memory->m_data = reinterpret_cast<void*>(address);
+        memory->m_xos_grant = WTF::move(storage.m_grant);
+        memory->m_xos_mapping = mapping;
+        memory->m_xos_protection = protection;
+        return memory;
+    }
+    return nullptr;
+}
+
+SharedMemory::~SharedMemory()
+{
+    RELEASE_ASSERT(!xos::ipc_v1::grant_unmap(m_xos_grant->m_handle, m_xos_mapping));
+}
+
+std::optional<SharedMemory::Handle> SharedMemory::createHandle(Protection protection)
+{
+    if (protection == Protection::ReadWrite && m_xos_protection != Protection::ReadWrite)
+        return std::nullopt;
+    return Handle(Handle::Type(Ref { *m_xos_grant }, protection), size());
+}
+
+} // namespace WebCore
+#endif
