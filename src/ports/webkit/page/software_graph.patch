@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstdint>
+#include <wtf/Vector.h>
+
+namespace WebCore {
+
+class CertificateInfo final {
+public:
+    using certificate_chain = Vector<Vector<uint8_t>>;
+
+    CertificateInfo() = default;
+    CertificateInfo(certificate_chain&& chain, unsigned validation_errors)
+        : m_chain(WTF::move(chain))
+        , m_validation_errors(validation_errors)
+    {
+    }
+
+    bool isEmpty() const { return m_chain.isEmpty(); }
+    bool operator==(const CertificateInfo&) const = default;
+    CertificateInfo isolatedCopy() const { return CertificateInfo(certificate_chain(m_chain), m_validation_errors); }
+    const certificate_chain& certificateChain() const { return m_chain; }
+    unsigned validationErrors() const { return m_validation_errors; }
+
+private:
+    certificate_chain m_chain;
+    unsigned m_validation_errors { 0 };
+};
+
+} // namespace WebCore
