+#if OS(XOS)
+// The JSC shell accesses configuration before its first WTF::initialize call.
+static void initialize_xos_config_mapping()
+{
+    static std::once_flag once_flag;
+    std::call_once(once_flag, [] {
+        void* const address = WebConfig::configuration_slots();
+        void* const mapping = mmap(address, ConfigSizeToProtect, PROT_NONE,
+            MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+        if (mapping == address && !mprotect(mapping, ConfigSizeToProtect, PROT_READ | PROT_WRITE))
+            return;
+
+        if (mapping != MAP_FAILED)
+            munmap(mapping, ConfigSizeToProtect);
+        // Fatal reporting cannot use WTF configuration until this mapping exists.
+        constexpr char failure[] = "ClarkE JSC configuration mapping failed\n";
+        static_cast<void>(write(STDERR_FILENO, failure, sizeof(failure) - 1));
+        _exit(EXIT_FAILURE);
+    });
+}
+
+__attribute__((constructor(101))) static void initialize_xos_config_before_cpp()
+{
+    initialize_xos_config_mapping();
+}
+#endif
